{
  "name": "karyakarta-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Karyakarta desktop app",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "web": "vite",
    "dev": "concurrently -k -n web,app \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "smoke": "electron . --smoke"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
